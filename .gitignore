# ==============================================================================
# Root .gitignore - TPC Alumni System
# ==============================================================================

# Environment files with sensitive credentials (Never commit!)
.env
.env.*
!.env.example
!.env.production.example
*.env
backend/.env
backend/.env.*
!backend/.env.example
!backend/.env.production.example
admin-web/.env
admin-web/.env.*
!admin-web/.env.example

# Credentials & Keys
*.pem
*.key
*.crt
*.cert
auth.json
oauth-*.json

# Dependencies
node_modules/
vendor/

# Builds & Outputs
dist/
dist-ssr/
public/build/
public/hot/
public/storage
storage/*.key
storage/pail

# Logs & Debug
*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Database & local runtime dumps
*.sqlite
*.sqlite-journal
mysql_data/
cloudflared.deb
database-backup/*.sql
!database-backup/clean_schema.sql

# IDE & OS files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
.fleet/
.nova/
.zed/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ==============================================================================
# TPC Alumni Management System - Production Environment Configuration
# ==============================================================================
# IMPORTANT: Copy this file to .env on your production server:
# cp .env.production.example .env
# Then run: php artisan key:generate
# ==============================================================================

APP_NAME="TPC Alumni Management System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8070

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ------------------------------------------------------------------------------
# Database Configuration (Docker MySQL service name is 'mysql')
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=capstone_db
DB_USERNAME=capstone_user
DB_PASSWORD=secret_change_me_in_production
DB_ROOT_PASSWORD=root_change_me_in_production

# ------------------------------------------------------------------------------
# Session & Cache (Uses Redis container)
# ------------------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
CACHE_PREFIX=tpc_alumni_cache

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# Queue Configuration (Jobs table in database, processed by capstone_queue worker)
# ------------------------------------------------------------------------------
QUEUE_CONNECTION=database

# ------------------------------------------------------------------------------
# Storage & Filesystem
# ------------------------------------------------------------------------------
FILESYSTEM_DISK=public

# ------------------------------------------------------------------------------
# CORS & Domains (Update with your actual domain or Cloudflare Tunnel URL)
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8070
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:8070
SANCTUM_EXPIRATION_MINUTES=20160

# ------------------------------------------------------------------------------
# Mail Configuration (SMTP for notification emails & password resets)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@tpc.edu.ph"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# Initial Super Admin Seed Password
# ------------------------------------------------------------------------------
SUPER_ADMIN_PASSWORD=ChangeThisSuperAdminPass123!
